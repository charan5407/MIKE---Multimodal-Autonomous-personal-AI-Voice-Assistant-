# ==============================================================================
# MIKE - Autonomous Agentic Desktop Voice Assistant Environment Config
# Keep your real keys in .env ONLY. Never commit .env or secrets to Git.
# ==============================================================================

# Application Mode
MIKE_ENV=development
LOG_LEVEL=INFO

# Brain (LLM Router Configuration)
# Options: ollama, gemini, groq
LLM_PRIMARY_PROVIDER=ollama
# Fallback chain order (comma-separated):
LLM_FALLBACK_PROVIDERS=gemini,groq

# 1. Ollama (Offline Local LLM)
# Default host: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 2. Google Gemini Free Tier (Vision & Native Tool Calling)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. Groq Free Tier (Fast Tool Calling & Low Latency)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Security & Private Profile Store
# Key will be generated automatically or set manually via Fernet:
PROFILE_ENCRYPTION_KEY=

# Music & Media (Spotify Free or Premium)
# Get free client credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# FastAPI & WebSocket Core Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
